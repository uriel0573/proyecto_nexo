import math
import rclpy
from geometry_msgs.msg import PoseStamped
from nav2_simple_commander.robot_navigator import BasicNavigator
from rclpy.node import Node
from std_msgs.msg import Float32, String


def quaternion_to_yaw_deg(orientation):
    """Convierte la orientacion en cuaternion a grados sexagesimales (yaw)."""
    siny_cosp = 2.0 * (
        orientation.w * orientation.z + orientation.x * orientation.y
    )
    cosy_cosp = 1.0 - 2.0 * (
        orientation.y * orientation.y + orientation.z * orientation.z
    )
    return round(math.degrees(math.atan2(siny_cosp, cosy_cosp)), 2)


class SmacNavigatorNode(Node):

    def __init__(self):
        super().__init__('smac_navigator_node')

        # --- Estado de Bateria ---
        self.battery_status = 'OK'
        self.battery_pct = 100.0

        # --- Suscriptores al BatteryManager ---
        self.create_subscription(
            String, '/nexo/battery/status', self.battery_status_cb, 10
        )
        self.create_subscription(
            Float32, '/nexo/battery/percentage', self.battery_pct_cb, 10
        )

        # --- Suscriptor a Foxglove (/goal_pose) ---
        self.create_subscription(
            PoseStamped, '/goal_pose', self.goal_pose_cb, 10
        )

        # --- Navegador Simple de Nav2 ---
        self.navigator = BasicNavigator()

        self.get_logger().info(
            'Nodo SmacNavigator listo y escuchando /goal_pose desde Foxglove.'
        )

    def battery_status_cb(self, msg: String):
        self.battery_status = msg.data

    def battery_pct_cb(self, msg: Float32):
        self.battery_pct = msg.data

    def goal_pose_cb(self, msg: PoseStamped):
        """Procesa la meta enviada desde Foxglove Studio."""
        x = round(msg.pose.position.x, 3)
        y = round(msg.pose.position.y, 3)
        yaw_deg = quaternion_to_yaw_deg(msg.pose.orientation)

        self.get_logger().info(
            f'Meta recibida desde Foxglove en -> X: {x}m, Y: {y}m, Yaw: {yaw_deg} deg'
        )
        self.send_goal_pose(msg)

    def send_goal_pose(self, goal_pose: PoseStamped):
        # 1. Regla de seguridad de Bateria antes de navegar
        if self.battery_status in [
            'LOW_BATTERY_RETURN',
            'CRITICAL_CHARGE_NOW',
        ]:
            self.get_logger().warn(
                f'Navegacion rechazada: Bateria en estado {self.battery_status} ({self.battery_pct}%).'
            )
            return False

        # 2. Enviar meta a Nav2 (Smac Planner Hybrid A*)
        self.get_logger().info(
            'Enviando meta a Nav2 usando Smac Planner (Hybrid A*)...'
        )
        self.navigator.goToPose(goal_pose)
        return True


def main(args=None):
    rclpy.init(args=args)
    node = SmacNavigatorNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
