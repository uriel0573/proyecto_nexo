planner_server:
  ros__parameters:
    expected_planner_frequency: 20.0
    use_sim_time: false
    planner_plugins: ["GridBased"]
    GridBased:
      plugin: "nav2_smac_planner/SmacPlannerHybrid"
      downsample_costmap: false #reduce resolucion si el CPU se sobrecarga
      downsampling_factor: 1
      tolerance: 0.25 #tolerancia de llegada a la meta
      allow_unknown: true #permitir planificar en zonas no exploradas
      max_iterations: 1000000 #iteraciones maximas del buscador A*
      max_on_approach_iterations: 1000
      max_planning_time: 2.0 #tiempo maximo de calculo (s)
      motion_model_for_search: "DUBINS" #Dubins solo avnce o Reeds_Shepp con reversa
      angle_quantization_bins: 72 #resolucion angular 5 grados por bin
      analytic_expansion_ratio: 3.5 #ratio de expansion analitica hacia la meta
      minimum_turning_radius: 0.25 #radio de giro minimo
      reverse_penalty: 2.1 #penalizacin por moverse en reversa
      change_penalty: 0.2 # penalizacin por cambiar de marcha
      non_straight_penalty: 1.25 #penalizacin por curvas
      cost_penalty: 1.3 #penalizacin por acercarse a obstaculos
      retarget_distance: 0.2
      lookup_table_size: 20.0
