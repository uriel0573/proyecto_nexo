#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from std_msgs.msg import Float32, String, UInt16


class BatteryManagerNode(Node):

    def __init__(self):
        super().__init__('battery_manager_node')

        # --- Parametros de Configuracion ---
        self.declare_parameter('min_operating_battery', 30.0)
        self.declare_parameter('critical_battery', 20.0)
        self.declare_parameter('base_discharge_rate', 1.67)   # %/min en reposo (60 min al 100%)
        self.declare_parameter('motion_discharge_gain', 15.0) # %/min extra por cada m/s
        self.declare_parameter('v_empty', 7.0)                # 0% = 7.0 V
        self.declare_parameter('v_full', 8.4)                 # 100% = 8.4 V

        self.min_battery = self.get_parameter('min_operating_battery').value
        self.critical_battery = self.get_parameter('critical_battery').value
        self.base_rate = self.get_parameter('base_discharge_rate').value
        self.motion_gain = self.get_parameter('motion_discharge_gain').value
        self.v_min = self.get_parameter('v_empty').value
        self.v_max = self.get_parameter('v_full').value

        # Factor de suavizado EMA (0.1 a 0.2 para eliminar picos de motores)
        self.alpha = 0.15

        # Variables de Estado Interno
        self.current_battery_pct = 100.0
        self.current_voltage = 0.0
        self.filtered_voltage = None
        self.system_status = 'WAITING_DATA'
        self.received_first_data = False

        # Velocidad suavizada para estimacion de autonomia
        self.filtered_speed = 0.0
        self.autonomy_minutes = 0.0

        # Suscriptor al Topico Real (/ros_robot_controller/battery en mV)
        self.battery_sub = self.create_subscription(
            UInt16,
            '/ros_robot_controller/battery',
            self.battery_callback,
            10,
        )

        # Suscriptor a la velocidad publicada por location_manager
        self.speed_sub = self.create_subscription(
            Float32,
            '/nexo/telemetry/speed',
            self.speed_callback,
            10,
        )

        # Publicadores Internos
        self.pct_pub = self.create_publisher(
            Float32, '/nexo/battery/percentage', 10
        )
        self.status_pub = self.create_publisher(
            String, '/nexo/battery/status', 10
        )
        self.voltage_pub = self.create_publisher(
            Float32, '/nexo/battery/voltage', 10
        )
        self.autonomy_pub = self.create_publisher(
            Float32, '/nexo/battery/autonomy_min', 10
        )

        # Timer a 1 Hz
        self.create_timer(1.0, self.evaluate_and_publish)
        self.get_logger().info(
            'BatteryManager iniciado con modelo realista de autonomia.'
        )

    def speed_callback(self, msg: Float32):
        # Guardar la velocidad real (0.0 si esta detenido)
        v_inst = msg.data if msg.data > 0.02 else 0.0
        self.filtered_speed = 0.25 * v_inst + 0.75 * self.filtered_speed

    def battery_callback(self, msg: UInt16):
        raw_voltage = msg.data / 1000.0

        if raw_voltage > 0.0:
            self.current_voltage = round(raw_voltage, 2)

            # Inicializar o aplicar Filtro Promedio Movil Exponencial (EMA)
            if self.filtered_voltage is None:
                self.filtered_voltage = raw_voltage
            else:
                self.filtered_voltage = (
                    self.alpha * raw_voltage
                    + (1.0 - self.alpha) * self.filtered_voltage
                )

            self.received_first_data = True

            # Calculo usando el voltaje suavizado
            pct = (
                (self.filtered_voltage - self.v_min)
                / (self.v_max - self.v_min)
            ) * 100.0

            # Mantener rango de 0.0% a 100.0%
            self.current_battery_pct = round(max(0.0, min(100.0, pct)), 1)

    def calculate_autonomy(self):
        # Tasa base en reposo + consumo proporcional a la velocidad de desplazamiento
        total_discharge_rate = self.base_rate + (self.motion_gain * self.filtered_speed)
        self.autonomy_minutes = round(
            self.current_battery_pct / max(0.1, total_discharge_rate), 1
        )

    def evaluate_and_publish(self):
        if not self.received_first_data:
            self.get_logger().warn(
                'Esperando lectura real de /ros_robot_controller/battery...',
                throttle_duration_sec=3.0,
            )
            return

        self.calculate_autonomy()

        # Evaluar limites de autonomia (30% y 20%)
        if self.current_battery_pct <= self.critical_battery:
            self.system_status = 'CRITICAL_CHARGE_NOW'
        elif self.current_battery_pct <= self.min_battery:
            self.system_status = 'LOW_BATTERY_RETURN'
        else:
            self.system_status = 'OK'

        v_display = round(self.filtered_voltage, 2)

        # Publicar en topicos
        pct_msg = Float32()
        pct_msg.data = float(self.current_battery_pct)
        self.pct_pub.publish(pct_msg)

        status_msg = String()
        status_msg.data = self.system_status
        self.status_pub.publish(status_msg)

        volt_msg = Float32()
        volt_msg.data = float(v_display)
        self.voltage_pub.publish(volt_msg)

        aut_msg = Float32()
        aut_msg.data = float(self.autonomy_minutes)
        self.autonomy_pub.publish(aut_msg)

        self.get_logger().info(
            f'Bateria: {self.current_battery_pct}% ({v_display}V) | '
            f'Autonomia: {self.autonomy_minutes} min | Estado: {self.system_status}'
        )


def main(args=None):
    rclpy.init(args=args)
    node = BatteryManagerNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
