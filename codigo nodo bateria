import rclpy
from rclpy.node import Node
from std_msgs.msg import Float32, String, UInt16


class BatteryManagerNode(Node):

    def __init__(self):
        super().__init__('battery_manager_node')

        # --- Parametros de Configuracion ---
        self.declare_parameter('min_operating_battery', 30.0)
        self.declare_parameter('critical_battery', 20.0)

        self.min_battery = self.get_parameter('min_operating_battery').value
        self.critical_battery = self.get_parameter('critical_battery').value

        # Rango de voltaje segun el microcontrolador (7.0V = 0%, 8.4V = 100%)
        self.v_min = 7.0
        self.v_max = 8.4

        # Factor de suavizado EMA (0.1 a 0.2 es ideal para eliminar picos de motores)
        self.alpha = 0.15

        # Variables de Estado Interno
        self.current_battery_pct = 100.0
        self.current_voltage = 0.0
        self.filtered_voltage = None
        self.system_status = 'WAITING_DATA'
        self.received_first_data = False

        # Suscriptor al Topico Real (/ros_robot_controller/battery en mV)
        self.battery_sub = self.create_subscription(
            UInt16,
            '/ros_robot_controller/battery',
            self.battery_callback,
            10,
        )

        # Publicadores Internos
        self.pct_pub = self.create_publisher(
            Float32, '/nexo/battery/percentage', 10
        )
        self.status_pub = self.create_publisher(
            String, '/nexo/battery/status', 10
        )

        # Timer a 1 Hz
        self.create_timer(1.0, self.evaluate_and_publish)
        self.get_logger().info(
            'Nodo BatteryManager iniciado con filtro de suavizado activado.'
        )

    def battery_callback(self, msg: UInt16):
        raw_voltage = msg.data / 1000.0

        if raw_voltage > 0.0:
            self.current_voltage = round(raw_voltage, 2)

            # Inicializar o aplicar Filtro Promedio Movil Exponencial (EMA)
            if self.filtered_voltage is None:
                self.filtered_voltage = raw_voltage
            else:
                self.filtered_voltage = (
                    self.alpha * raw_voltage
                    + (1.0 - self.alpha) * self.filtered_voltage
                )

            self.received_first_data = True

            # Calculo usando el voltaje suavizado
            pct = (
                (self.filtered_voltage - self.v_min)
                / (self.v_max - self.v_min)
            ) * 100.0

            # Mantener rango de 0.0% a 100.0%
            self.current_battery_pct = round(max(0.0, min(100.0, pct)), 1)

    def evaluate_and_publish(self):
        if not self.received_first_data:
            self.get_logger().warn(
                'Esperando lectura real de /ros_robot_controller/battery...',
                throttle_duration_sec=3.0,
            )
            return

        # Evaluar limites de autonomia (30% y 20%)
        if self.current_battery_pct <= self.critical_battery:
            self.system_status = 'CRITICAL_CHARGE_NOW'
        elif self.current_battery_pct <= self.min_battery:
            self.system_status = 'LOW_BATTERY_RETURN'
        else:
            self.system_status = 'OK'

        # Publicar en topicos
        pct_msg = Float32()
        pct_msg.data = self.current_battery_pct
        self.pct_pub.publish(pct_msg)

        status_msg = String()
        status_msg.data = self.system_status
        self.status_pub.publish(status_msg)

        v_display = round(self.filtered_voltage, 2)
        self.get_logger().info(
            f'Bateria Real (Filtrada): {self.current_battery_pct}% ({v_display}V) | Estado: {self.system_status}'
        )


def main(args=None):
    rclpy.init(args=args)
    node = BatteryManagerNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
